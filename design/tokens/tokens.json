{
  "$description": "GrooveRift design tokens v0.1 (approved 2026-11-01: D-038 to D-041, step 3.4). DTCG-style: groups with $value/$type, aliases as {path}. Brand primitives are CONFIRMED (Master Prompt 15.2); everything else is design-system work. Docs: docs/design/tokens.md.",
  "color": {
    "$type": "color",
    "ember": {
      "$description": "CONFIRMED brand palette. Never change without owner approval.",
      "coral": { "$value": "#FF586B", "$description": "Primary Coral" },
      "amber": { "$value": "#FFCB69", "$description": "Secondary Amber" },
      "void": { "$value": "#0B0D12", "$description": "Void Black, main background" },
      "coral-hover": { "$value": "#FF7081", "$description": "Coral lightened for hover on dark UI (not a new brand color)" },
      "coral-pressed": { "$value": "#E94B5E", "$description": "Coral darkened for pressed state" },
      "amber-hover": { "$value": "#FFD688" },
      "amber-pressed": { "$value": "#EDB650" }
    },
    "neutral": {
      "$description": "Neutral ramp tinted toward Void Black (cool). Not a brand palette.",
      "900": { "$value": "#12151C" },
      "850": { "$value": "#191D26" },
      "800": { "$value": "#222733" },
      "700": { "$value": "#2A2F3B" },
      "600": { "$value": "#4F5564" },
      "500": { "$value": "#737A8C" },
      "300": { "$value": "#A9AFBC" },
      "100": { "$value": "#F1F3F7" }
    },
    "tint": {
      "$description": "Brand colors pre-mixed over neutral.900 (opaque, so contrast can be computed).",
      "coral-16": { "$value": "#382029", "$description": "16% Coral over neutral.900" },
      "coral-12": { "$value": "#2E1D25", "$description": "12% Coral over neutral.900" },
      "amber-10": { "$value": "#2A2724", "$description": "10% Amber over neutral.900" },
      "green-12": { "$value": "#1B2C2B", "$description": "12% green.400 over neutral.900" }
    },
    "green": {
      "400": { "$value": "#5ED39A", "$description": "Success only. Used sparingly, always with an icon." }
    },
    "black-alpha": {
      "60": { "$value": "#00000099", "$description": "Scrim behind dialogs and sheets" },
      "50": { "$value": "#00000080" }
    },

    "bg": {
      "canvas": { "$value": "{color.ember.void}", "$description": "Page background" },
      "surface": { "$value": "{color.neutral.900}", "$description": "Cards, lists, bars" },
      "raised": { "$value": "{color.neutral.850}", "$description": "Sheets, dialogs, menus, inputs" },
      "high": { "$value": "{color.neutral.800}", "$description": "Hover and pressed on surfaces; nested raised" },
      "scrim": { "$value": "{color.black-alpha.60}" }
    },
    "border": {
      "subtle": { "$value": "{color.neutral.700}", "$description": "Decorative dividers only. Not for component boundaries (fails 3:1 by design)." },
      "strong": { "$value": "{color.neutral.500}", "$description": "Component boundaries: inputs, outline buttons, unselected chips, toggles (>= 3:1)" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.100}" },
      "secondary": { "$value": "{color.neutral.300}", "$description": "Meta, helper text, placeholders, inactive nav labels" },
      "disabled": { "$value": "{color.neutral.600}", "$description": "Disabled controls only (exempt from 1.4.3). Never for information." },
      "link": { "$value": "{color.ember.amber}" },
      "accent": { "$value": "{color.ember.coral}", "$description": "Active nav label, brand emphasis in text" },
      "on-accent": { "$value": "{color.ember.void}", "$description": "Text and icons on Coral, Amber or gradient fills (R-09)" }
    },
    "action": {
      "primary": { "$value": "{color.ember.coral}", "$description": "Primary button fill. One primary action per view." },
      "primary-hover": { "$value": "{color.ember.coral-hover}" },
      "primary-pressed": { "$value": "{color.ember.coral-pressed}" },
      "secondary": { "$value": "{color.bg.raised}", "$description": "Secondary button fill, with border.strong" }
    },
    "selected": {
      "bg": { "$value": "{color.tint.coral-16}", "$description": "Selected chip / toggle background. Always paired with a check icon or text (1.4.1)." },
      "border": { "$value": "{color.ember.coral}" }
    },
    "highlight": {
      "bg": { "$value": "{color.tint.amber-10}", "$description": "Daily Drop and discovery moments" },
      "border": { "$value": "{color.ember.amber}" },
      "text": { "$value": "{color.ember.amber}", "$description": "Daily Drop eyebrow" }
    },
    "focus": {
      "ring": { "$value": "{color.ember.amber}", "$description": "Outer focus ring" },
      "gap": { "$value": "{color.ember.void}", "$description": "Inner ring between element and focus ring, so the ring also shows on Amber or Coral fills" }
    },
    "state": {
      "danger": { "$value": "{color.ember.coral}", "$description": "Errors and destructive actions. Always with icon + text." },
      "danger-bg": { "$value": "{color.tint.coral-12}" },
      "warning": { "$value": "{color.ember.amber}", "$description": "Always with icon + text" },
      "warning-bg": { "$value": "{color.tint.amber-10}" },
      "success": { "$value": "{color.green.400}" },
      "success-bg": { "$value": "{color.tint.green-12}" },
      "info": { "$value": "{color.text.secondary}", "$description": "Info is neutral; no extra hue" }
    }
  },

  "gradient": {
    "$type": "gradient",
    "brand": {
      "$value": [
        { "color": "{color.ember.coral}", "position": 0 },
        { "color": "{color.ember.amber}", "position": 1 }
      ],
      "$description": "Coral to Amber, left to right (logo treatment). Purposeful use only (15.2): brand moments, Music DNA identity art. Text on it uses text.on-accent."
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": ["Sora", "Segoe UI", "system-ui", "sans-serif"], "$description": "Key headings, onboarding, editorial" },
      "body": { "$value": ["Inter", "Segoe UI", "system-ui", "-apple-system", "Roboto", "sans-serif"], "$description": "UI and body text" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "rem so text scales with the user's browser setting (1.4.4). Root stays at the browser default (16px).",
      "xs": { "$value": "0.8125rem", "$description": "13px: captions, timestamps. Minimum for text." },
      "sm": { "$value": "0.875rem", "$description": "14px: meta, chips, nav labels on desktop" },
      "md": { "$value": "1rem", "$description": "16px: body, inputs (prevents iOS zoom)" },
      "lg": { "$value": "1.125rem", "$description": "18px" },
      "xl": { "$value": "1.25rem", "$description": "20px" },
      "2xl": { "$value": "1.5rem", "$description": "24px" },
      "3xl": { "$value": "1.875rem", "$description": "30px" },
      "4xl": { "$value": "2.25rem", "$description": "36px" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "heading": { "$value": "-0.01em" },
      "normal": { "$value": "0em" },
      "caps": { "$value": "0.06em", "$description": "Uppercase eyebrows only" }
    }
  },

  "type": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "{font.size.4xl}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.heading}" }, "$description": "Onboarding and brand moments only" },
    "title-1": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.3xl}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.heading}" } },
    "title-2": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.2xl}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.heading}" }, "$description": "Daily Drop question, screen titles" },
    "title-3": { "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.xl}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "body": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.md}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "body-sm": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.sm}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "label": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.sm}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "Buttons, chips, tabs" },
    "caption": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "eyebrow": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.caps}" }, "$description": "Uppercase section labels" }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px grid in rem.",
    "0": { "$value": "0rem" },
    "half": { "$value": "0.125rem", "$description": "2px" },
    "1": { "$value": "0.25rem", "$description": "4px" },
    "2": { "$value": "0.5rem", "$description": "8px" },
    "3": { "$value": "0.75rem", "$description": "12px" },
    "4": { "$value": "1rem", "$description": "16px" },
    "5": { "$value": "1.25rem", "$description": "20px" },
    "6": { "$value": "1.5rem", "$description": "24px" },
    "8": { "$value": "2rem", "$description": "32px" },
    "10": { "$value": "2.5rem", "$description": "40px" },
    "12": { "$value": "3rem", "$description": "48px" },
    "16": { "$value": "4rem", "$description": "64px" }
  },

  "size": {
    "$type": "dimension",
    "target": {
      "min": { "$value": "44px", "$description": "Primary controls, nav items, icon buttons (ux-foundations 4.2)" },
      "dense": { "$value": "24px", "$description": "Hard floor for dense inline controls such as reactions (WCAG 2.5.8)" }
    },
    "icon": {
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" }
    },
    "content-max": { "$value": "40rem", "$description": "Reading column for feeds and threads" }
  },

  "radius": {
    "$type": "dimension",
    "control": { "$value": "10px", "$description": "Buttons, inputs, segmented controls" },
    "card": { "$value": "12px" },
    "chip": { "$value": "9999px" },
    "sheet": { "$value": "20px", "$description": "Top corners of bottom sheets; dialogs" },
    "full": { "$value": "9999px", "$description": "Avatars, pills, dots" }
  },

  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "thick": { "$value": "2px", "$description": "Selected states, active indicators" }
  },

  "focus": {
    "$type": "dimension",
    "width": { "$value": "2px", "$description": "Outer ring (color.focus.ring)" },
    "gap": { "$value": "2px", "$description": "Inner ring (color.focus.gap). Total indicator: 4px." }
  },

  "shadow": {
    "$type": "shadow",
    "overlay": {
      "$value": { "color": "{color.black-alpha.50}", "offsetX": "0px", "offsetY": "8px", "blur": "32px", "spread": "0px" },
      "$description": "Dialogs, sheets, menus, toasts only. Elevation on surfaces comes from bg steps and borders, not shadows."
    }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Every duration becomes 0ms under prefers-reduced-motion (see $extensions).",
      "fast": { "$value": "120ms", "$description": "Hover, press, toggles", "$extensions": { "app.grooverift.reducedMotion": "0ms" } },
      "base": { "$value": "200ms", "$description": "Sheets, dialogs, toasts", "$extensions": { "app.grooverift.reducedMotion": "0ms" } },
      "slow": { "$value": "320ms", "$description": "Page-level transitions, onboarding steps", "$extensions": { "app.grooverift.reducedMotion": "0ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Min-widths. compact (<600): bottom bar. medium (600+): collapsed rail. expanded (1024+): rail with labels. wide (1280+): optional context column (IA 3.2). CSS variables cannot be used in @media; mirror these values.",
    "medium": { "$value": "600px" },
    "expanded": { "$value": "1024px" },
    "wide": { "$value": "1280px" }
  },

  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 100, "$description": "Top bar" },
    "nav": { "$value": 200, "$description": "Bottom bar and rail" },
    "overlay": { "$value": 300, "$description": "Scrim, sheets, dialogs" },
    "toast": { "$value": 400 }
  }
}
