# GrooveRift local environment. Copy to .env.local and fill in. Never commit .env.local.
# Every value here is a placeholder; none is a real secret.

# Where the app is served (no trailing slash). Used by Better Auth for cookies, links and CSRF.
APP_URL=http://localhost:3000

# PostgreSQL (docker compose up -d starts one with these values).
DATABASE_URL=postgres://grooverift:grooverift@127.0.0.1:5432/grooverift

# Better Auth secret: at least 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-generate-32-random-bytes

# Google sign-in (optional in development; leave empty to hide the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sending. Development logs verification and reset links to the server console. Staging and production use
# EMAIL_TRANSPORT=zeptomail (D-110) with the API host and the Send Mail token from the ZeptoMail console.
EMAIL_FROM=GrooveRift <no-reply@localhost>
EMAIL_TRANSPORT=console
ZEPTOMAIL_API_URL=
ZEPTOMAIL_TOKEN=

# Client IP: comma-separated request headers that carry it, in order of trust. Empty locally (no proxy).
# REQUIRED in production (Render: x-forwarded-for), or every client would share one rate-limit bucket.
IP_HEADERS=
# Proxies that append to X-Forwarded-For (Better Auth trustedProxies), comma-separated. Usually empty.
TRUSTED_PROXIES=


# MusicBrainz User-Agent contact (A4, D-092, D-108): the project role mailbox on grooverift.com, never a personal
# address and never in the code. Required for live MusicBrainz lookups (step 5.3b).
MUSICBRAINZ_CONTACT=

# Error tracking (D-111): Sentry, EU region. Empty in development and CI: nothing is loaded or sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Object storage (D-113): Cloudflare R2, bucket in the EU jurisdiction. The endpoint must be the EU one
# (https://<account-id>.eu.r2.cloudflarestorage.com). Empty in development and CI until step 5.11 uses it.
# Check a deployment with `npm run r2:test`.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
